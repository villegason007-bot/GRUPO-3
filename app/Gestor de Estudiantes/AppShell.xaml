<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="Gestor_de_Estudiantes.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Gestor_de_Estudiantes"
    FlyoutBehavior="Locked"
    FlyoutWidth="260"
    FlyoutBackgroundColor="#0F172A"
    BackgroundColor="#0F172A"
    Title="Gestor de Estudiantes">

    <Shell.Resources>
        <ResourceDictionary>

            <Style x:Key="SidebarButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#E2E8F0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalOptions" Value="Fill" />
            </Style>

            <!-- Etiquetas de sección -->
            <Style x:Key="SidebarSectionLabel" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.2" />
                <Setter Property="TextColor" Value="#94A3B8" />
                <Setter Property="Margin" Value="12,8,0,4" />
            </Style>

            <!-- Texto secundario -->
            <Style x:Key="SidebarSubText" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="#64748B" />
            </Style>

        </ResourceDictionary>
    </Shell.Resources>

    <Shell.FlyoutContent>
        <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" BackgroundColor="#0F172A">

            <!-- Logo / Identidad -->
            <Grid ColumnDefinitions="42,*" ColumnSpacing="12">
                <Border
                    WidthRequest="42"
                    HeightRequest="42"
                    Background="#2563EB"
                    Stroke="#1E40AF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8">
                    <Label
                        Text="G"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="Gestor" FontSize="15" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Estudiantes" Style="{StaticResource SidebarSubText}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Separador -->
            <BoxView Grid.Row="1" HeightRequest="1" Margin="0,16" Color="#1E293B" />

            <!-- Menú principal -->
            <ScrollView Grid.Row="2">
                <VerticalStackLayout Spacing="8">

                    <Label Text="Espacio de trabajo" Style="{StaticResource SidebarSectionLabel}" />

                    <Button Text="⌂   Inicio" Style="{StaticResource SidebarButton}" Clicked="OnInicioClicked" />
                    <Button Text="▤   Comisiones" Style="{StaticResource SidebarButton}" Clicked="OnVerComisionesClicked" />
                    <Button Text="✓   Asistencia y entregas" Style="{StaticResource SidebarButton}" Clicked="OnAsistenciaEntregasClicked" />
                    <Button Text="◉   Indicador de riesgo" Style="{StaticResource SidebarButton}" Clicked="OnRiesgoClicked" />
                    <Button Text="▦   Calendario" Style="{StaticResource SidebarButton}" Clicked="OnCalendarioClicked" />

                    <BoxView HeightRequest="1" Margin="0,12" Color="#1E293B" />

                    <Label Text="Preferencias" Style="{StaticResource SidebarSectionLabel}" />

                    <Button Text="⚙   Configuración de riesgo" Style="{StaticResource SidebarButton}" BackgroundColor="Gray" />

                </VerticalStackLayout>
            </ScrollView>

            <!-- Footer -->
            <Border Grid.Row="3" Padding="12" Background="#1E293B" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Panel académico" FontSize="11" FontAttributes="Bold" TextColor="#E2E8F0" />
                    <Label Text="Gestión y seguimiento de cursada" Style="{StaticResource SidebarSubText}" />
                </VerticalStackLayout>
            </Border>

        </Grid>
    </Shell.FlyoutContent>

    <ShellContent
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
