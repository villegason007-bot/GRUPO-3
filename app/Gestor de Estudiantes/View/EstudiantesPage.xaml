<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gestor_de_Estudiantes.Views.EstudiantesPage"
             Title="Estudiantes"
             Loaded="ContentPage_Loaded">

    <Grid RowDefinitions="*,Auto" Padding="15" RowSpacing="10">

        <ListView Grid.Row="0" ItemsSource="{Binding ListadoEstudiantes}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Nombre}" Detail="{Binding Legajo}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="1"
                Text="Agregar estudiante"
                Clicked="OnAgregarClicked" />
    </Grid>

</ContentPage>