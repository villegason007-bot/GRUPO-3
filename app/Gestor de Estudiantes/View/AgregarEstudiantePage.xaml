<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gestor_de_Estudiantes.Views.AgregarEstudiantePage"
             Title="Nuevo estudiante">

    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">

        <Label Text="Nuevo estudiante" FontSize="22" FontAttributes="Bold" />

        <Entry x:Name="LegajoEntry" Placeholder="Legajo" />
        <Entry x:Name="NombreEntry" Placeholder="Nombre" />

        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />

        <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
            <Button Text="Cancelar" Clicked="OnCancelarClicked" />
            <Button Text="Guardar" Clicked="OnGuardarClicked" />
        </HorizontalStackLayout>

    </VerticalStackLayout>

</ContentPage>