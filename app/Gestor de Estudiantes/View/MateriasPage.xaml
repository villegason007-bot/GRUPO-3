<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Gestor_de_Estudiantes.Views.MateriasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Gestor_de_Estudiantes.Controls"
    Title="Materias"
    BackgroundColor="#090D18">

    <Grid>
        <controls:FondoAmbiental />

        <Grid Padding="26,26,26,16" RowDefinitions="Auto,*" RowSpacing="18">

            <VerticalStackLayout Spacing="14">
                <VerticalStackLayout Spacing="7">
                    <Label Text="PLAN DE ESTUDIOS" FontSize="10" FontAttributes="Bold"
                           CharacterSpacing="1.7" TextColor="#A5B4FC" />
                    <Label Text="Materias" FontSize="32" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Creá o eliminá materias. Se asignan desde cada comisión."
                           FontSize="14" TextColor="{StaticResource TextoSecundario}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <Button Text="+ Crear materia"
                        Style="{StaticResource GlassButton}"
                        Clicked="AbrirModalMateria_Clicked" />
            </VerticalStackLayout>

            <Grid Grid.Row="1">
                <controls:EstadoVacio
                    x:Name="SinMateriasLabel"
                    Text="Todavía no hay materias. Usá el botón para crear la primera."
                    VerticalOptions="Start"
                    Margin="0,12"
                    IsVisible="False" />

                <CollectionView x:Name="MateriasList" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="9" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#16FFFFFF" Stroke="#30FFFFFF" StrokeThickness="1"
                                    Padding="16,12" StrokeShape="RoundRectangle 16">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="38" HeightRequest="38"
                                            Background="#302D75DB" Stroke="#5060A5FA"
                                            StrokeThickness="1" StrokeShape="RoundRectangle 12">
                                        <Label Text="▦" FontSize="16" TextColor="#BFDBFE"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Nombre}" FontSize="16"
                                           FontAttributes="Bold" TextColor="White"
                                           VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                    <Button Grid.Column="2" Text="Eliminar"
                                            BackgroundColor="#33F87171" TextColor="#FCA5A5"
                                            FontSize="12" FontAttributes="Bold"
                                            CornerRadius="10" Padding="12,6"
                                            Clicked="EliminarMateria_Clicked" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <controls:AvisoToast x:Name="Aviso" ZIndex="20" />

        <controls:GlassModal
            x:Name="ModalMateria"
            IsVisible="False"
            ZIndex="10"
            Icono="▦"
            IconoFondo="#302D75DB"
            IconoBorde="#5060A5FA"
            IconoColor="#BFDBFE"
            IconoTamano="25"
            Titulo="Nueva materia"
            Subtitulo="Ingresá el nombre de la materia que querés crear."
            TextoConfirmar="Guardar materia"
            CancelarClicked="CancelarModal_Clicked"
            ConfirmarClicked="GuardarMateria_Clicked">
            <controls:GlassModal.Formulario>
                <VerticalStackLayout Spacing="15">
                    <Label Text="NOMBRE DE LA MATERIA" Style="{StaticResource FormLabel}" />
                    <Entry x:Name="NombreMateriaEntry" Style="{StaticResource GlassEntry}"
                           Placeholder="Ej. Matemática" ReturnType="Done" />
                </VerticalStackLayout>
            </controls:GlassModal.Formulario>
        </controls:GlassModal>
    </Grid>
</ContentPage>
