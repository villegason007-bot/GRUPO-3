<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Gestor_de_Estudiantes.Views.AsistenciaEntregasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#090D18">


    <Grid>

        <!-- Fondo ambiental -->
        <Grid InputTransparent="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#090D18" Offset="0" />
                    <GradientStop Color="#11182A" Offset="0.55" />
                    <GradientStop Color="#201C43" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Ellipse
                WidthRequest="390"
                HeightRequest="390"
                HorizontalOptions="End"
                VerticalOptions="Start"
                TranslationX="155"
                TranslationY="-200">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#405B4CF0" Offset="0" />
                        <GradientStop Color="#005B4CF0" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse
                WidthRequest="300"
                HeightRequest="300"
                HorizontalOptions="Start"
                VerticalOptions="End"
                TranslationX="-190"
                TranslationY="140">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#302D75DB" Offset="0" />
                        <GradientStop Color="#002D75DB" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Contenido Principal -->
        <ScrollView>
            <VerticalStackLayout
                Padding="26,26,26,34"
                Spacing="22">

                <!-- Encabezado -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">

                    <VerticalStackLayout Spacing="7">
                        <Label
                            Text="GESTIÓN ACADÉMICA"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.7"
                            TextColor="#A5B4FC" />

                        <Label
                            Text="Asistencia y entregas"
                            FontSize="32"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Administrá la asistencia y las entregas de tus estudiantes."
                            FontSize="14"
                            TextColor="{StaticResource TextoSecundario}"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Selector de comisión activa -->
                <Border Style="{StaticResource GlassCard}">
                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="01 / COMISIÓN"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1.5"
                                TextColor="#A5B4FC" />
                            <Label
                                Text="Comisión activa"
                                Style="{StaticResource SectionTitle}" />
                            <Label
                                Text="Seleccioná la cursada con la que deseas trabajar."
                                Style="{StaticResource SecondaryText}" />
                        </VerticalStackLayout>

                        <Border Style="{StaticResource InnerGlassCard}">
                            <Picker
                                Title="Seleccionar comisión"
                                ItemsSource="{Binding Comisiones}"
                                SelectedItem="{Binding ComisionSeleccionada}"
                                ItemDisplayBinding="{Binding Codigo}"
                                TextColor="White"
                                TitleColor="#A5B4FC"
                                BackgroundColor="Transparent" />
                        </Border>

                        <Button
                            Text="↻  Actualizar información"
                            Command="{Binding RecargarCommand}"
                            Style="{StaticResource SecondaryGlassButton}"
                            HorizontalOptions="Fill" />

                    </VerticalStackLayout>
                </Border>

                <!-- Topbar de pestañas -->
                <Border
                    Background="#16FFFFFF"
                    Stroke="#30FFFFFF"
                    StrokeThickness="1"
                    Padding="6"
                    StrokeShape="RoundRectangle 16">

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">

                        <Button
                            x:Name="TabAsistenciaButton"
                            Grid.Column="0"
                            Text="✓   Asistencia"
                            BackgroundColor="{StaticResource Acento}"
                            TextColor="White"
                            CornerRadius="12"
                            FontAttributes="Bold"
                            FontSize="13"
                            Padding="12,13"
                            Clicked="MostrarAsistenciaTab_Clicked" />

                        <Button
                            x:Name="TabEntregasButton"
                            Grid.Column="1"
                            Text="▤   Entregas"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextoSecundario}"
                            CornerRadius="12"
                            FontAttributes="Bold"
                            FontSize="13"
                            Padding="12,13"
                            Clicked="MostrarEntregasTab_Clicked" />

                    </Grid>
                </Border>

                <!-- Pestaña Asistencia -->
                <Border
                    x:Name="AsistenciaPanel"
                    Style="{StaticResource GlassCard}">

                    <VerticalStackLayout Spacing="17">

                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="02 / CONTROL"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1.5"
                                TextColor="#A5B4FC" />

                            <Label
                                Text="Control de asistencia"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                Text="Seleccioná una clase y marcá quién estuvo presente."
                                FontSize="13"
                                TextColor="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>

                        <Border Style="{StaticResource InnerGlassCard}">
                            <Picker
                                Title="Seleccionar clase"
                                ItemsSource="{Binding Clases}"
                                SelectedItem="{Binding ClaseSeleccionada}"
                                ItemDisplayBinding="{Binding Fecha}"
                                TextColor="White"
                                TitleColor="#A5B4FC"
                                BackgroundColor="Transparent" />
                        </Border>

                        <Border Style="{StaticResource InnerGlassCard}">
                            <Label
                                Text="Las casillas marcadas se guardan como presentes. Las que quedan sin marcar se guardan como ausencias."
                                TextColor="#CBD5E1"
                                FontSize="12" />
                        </Border>

                        <!-- Contenedor del listado ampliado -->
                        <CollectionView
                            ItemsSource="{Binding Asistencias}"
                            SelectionMode="None"
                            HeightRequest="480">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout
                                    Orientation="Vertical"
                                    ItemSpacing="10" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.EmptyView>
                                <VerticalStackLayout
                                    Padding="16"
                                    Spacing="8"
                                    HorizontalOptions="Center">
                                    <Label
                                        Text="No hay estudiantes para mostrar."
                                        TextColor="{StaticResource TextoSecundario}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="#14FFFFFF"
                                        Stroke="#2DFFFFFF"
                                        StrokeThickness="1"
                                        Padding="15"
                                        StrokeShape="RoundRectangle 16">

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="12">

                                            <VerticalStackLayout
                                                Grid.Column="0"
                                                Spacing="4"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding Estudiante.Nombre}"
                                                    TextColor="White"
                                                    FontAttributes="Bold"
                                                    FontSize="15" />

                                                <Label
                                                    Text="{Binding Estudiante.Legajo, StringFormat='Legajo: {0}'}"
                                                    TextColor="{StaticResource TextoSecundario}"
                                                    FontSize="12" />

                                            </VerticalStackLayout>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="2"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">

                                                <CheckBox
                                                    IsChecked="{Binding Presente}"
                                                    Color="#A5B4FC"
                                                    HorizontalOptions="Center" />

                                                <Label
                                                    Text="Presente"
                                                    TextColor="#C7D2FE"
                                                    FontSize="11"
                                                    HorizontalTextAlignment="Center" />

                                            </VerticalStackLayout>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button
                            Text="Guardar asistencias"
                            Command="{Binding GuardarAsistenciasCommand}"
                            Style="{StaticResource GlassButton}" />

                    </VerticalStackLayout>
                </Border>

                <!-- Pestaña Entregas -->
                <Border
                    x:Name="EntregasPanel"
                    Style="{StaticResource GlassCard}"
                    IsVisible="False">

                    <VerticalStackLayout Spacing="17">

                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="03 / TRABAJOS"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1.5"
                                TextColor="#A5B4FC" />

                            <Label
                                Text="Entregas de trabajos"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                Text="Elegí el trabajo y registrá las entregas de cada estudiante."
                                FontSize="13"
                                TextColor="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>

                        <Border Style="{StaticResource InnerGlassCard}">
                            <Picker
                                Title="Seleccionar trabajo"
                                ItemsSource="{Binding Trabajos}"
                                SelectedItem="{Binding TrabajoSeleccionado}"
                                ItemDisplayBinding="{Binding Titulo}"
                                TextColor="White"
                                TitleColor="#A5B4FC"
                                BackgroundColor="Transparent" />
                        </Border>

                        <!-- Contenedor del listado ampliado -->
                        <CollectionView
                            ItemsSource="{Binding Entregas}"
                            SelectionMode="None"
                            HeightRequest="520">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout
                                    Orientation="Vertical"
                                    ItemSpacing="10" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.EmptyView>
                                <VerticalStackLayout
                                    Padding="16"
                                    Spacing="8"
                                    HorizontalOptions="Center">
                                    <Label
                                        Text="No hay estudiantes o trabajos para mostrar."
                                        TextColor="{StaticResource TextoSecundario}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="#14FFFFFF"
                                        Stroke="#2DFFFFFF"
                                        StrokeThickness="1"
                                        Padding="15"
                                        StrokeShape="RoundRectangle 16">

                                        <VerticalStackLayout Spacing="10">

                                            <Label
                                                Text="{Binding Estudiante.Nombre}"
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                TextColor="White" />

                                            <Label
                                                Text="{Binding Estudiante.Legajo, StringFormat='Legajo: {0}'}"
                                                TextColor="{StaticResource TextoSecundario}"
                                                FontSize="12" />

                                            <BoxView
                                                HeightRequest="1"
                                                Color="#24FFFFFF" />

                                            <HorizontalStackLayout
                                                Spacing="8"
                                                VerticalOptions="Center">

                                                <CheckBox
                                                    IsChecked="{Binding Entregado}"
                                                    Color="#A5B4FC" />

                                                <Label
                                                    Text="Trabajo entregado"
                                                    TextColor="White"
                                                    VerticalOptions="Center" />

                                            </HorizontalStackLayout>

                                            <Label
                                                Text="Fecha de entrega"
                                                TextColor="{StaticResource TextoSecundario}"
                                                FontSize="12" />

                                            <Border Style="{StaticResource InnerGlassCard}">
                                                <DatePicker
                                                    Date="{Binding Fecha}"
                                                    TextColor="White"
                                                    BackgroundColor="Transparent" />
                                            </Border>

                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button
                            Text="Guardar entregas"
                            Command="{Binding GuardarEntregasCommand}"
                            Style="{StaticResource GlassButton}" />

                    </VerticalStackLayout>
                </Border>

                <!-- Mensajes del ViewModel -->
                <Border Style="{StaticResource InnerGlassCard}">
                    <Label
                        Text="{Binding Mensaje}"
                        TextColor="#93C5FD"
                        FontSize="14" />
                </Border>

                <!-- Pie -->
                <Label
                    Text="GESTOR DE ESTUDIANTES  ·  ESPACIO ACADÉMICO"
                    FontSize="10"
                    CharacterSpacing="1.1"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center"
                    Margin="0,4,0,0" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>