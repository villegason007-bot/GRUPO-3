<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Gestor_de_Estudiantes.Views.HistorialEntregasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Gestor_de_Estudiantes.Controls"
    Title="Historial de entregas"
    BackgroundColor="#090D18">

    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="14">

        <!-- Encabezado: nombre y legajo/comisión -->
        <VerticalStackLayout Spacing="5">
            <Label
                Text="{Binding NombreCompleto}"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White" />

            <Label
                Text="{Binding Subtitulo}"
                FontSize="13"
                TextColor="#94A3B8" />
        </VerticalStackLayout>

        <!-- Mensaje de estado o de error -->
        <Label
            Grid.Row="1"
            Text="{Binding Mensaje}"
            TextColor="#94A3B8"
            FontSize="13"
            IsVisible="{Binding MostrarMensaje}" />

        <!-- Bloque de riesgo individual (H13) -->
        <Border
            Grid.Row="2"
            Style="{StaticResource GlassCard}"
            Padding="18">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="12">

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="INDICADOR DE RIESGO"
                        FontSize="11"
                        FontAttributes="Bold"
                        CharacterSpacing="1.1"
                        TextColor="#64748B" />

                    <Label
                        Text="{Binding RiesgoIndividual.Motivo}"
                        FontSize="13"
                        TextColor="#CBD5E1" />

                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="18">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                Text="FALTAS"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />
                            <Label
                                Text="{Binding RiesgoIndividual.Faltas}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#E2E8F0" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label
                                Text="NO ENTREGADOS"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />
                            <Label
                                Text="{Binding RiesgoIndividual.Trabajos}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#E2E8F0" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- Badge de estado -->
                <Border
                    Grid.Column="1"
                    Padding="12,8"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    BackgroundColor="{Binding RiesgoIndividual.BadgeColor}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8">

                    <Label
                        Text="{Binding RiesgoIndividual.Estado}"
                        TextColor="{Binding RiesgoIndividual.BadgeTextColor}"
                        FontSize="12"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />
                </Border>

            </Grid>
        </Border>

        <!-- Título de la sección -->
        <Label
            Grid.Row="3"
            Text="Entregas de la comisión"
            Style="{StaticResource SectionTitle}" />

        <!-- Lista del historial (H13) -->
        <CollectionView
            Grid.Row="4"
            ItemsSource="{Binding Filas}">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <controls:EstadoVacio
                    Text="Todavía no hay trabajos cargados en la comisión."
                    Margin="16"
                    HorizontalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Background="#14FF"
                        Padding="15"
                        Stroke="#263244"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                            <VerticalStackLayout
                                Spacing="3"
                                VerticalOptions="Center">
                                <Label
                                    Text="{Binding Titulo}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#F8FAFC"
                                    LineBreakMode="TailTruncation" />
                                <Label
                                    Text="{Binding FechaVencimientoTexto}"
                                    FontSize="12"
                                    TextColor="#64748B" />
                            </VerticalStackLayout>

                            <!-- Badge de estado de entrega -->
                            <Border
                                Grid.Column="1"
                                Padding="10,6"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                BackgroundColor="{Binding BadgeColor}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">

                                <Label
                                    Text="{Binding EstadoTexto}"
                                    TextColor="{Binding BadgeTextColor}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center" />
                            </Border>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
