<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Gestor_de_Estudiantes.Views.AgregarComisionPage"
    BackgroundColor="#090D18">


    <Grid>

        <!-- Fondo ambiental -->
        <Grid InputTransparent="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#090D18" Offset="0" />
                    <GradientStop Color="#11182A" Offset="0.55" />
                    <GradientStop Color="#201C43" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Ellipse
                WidthRequest="390"
                HeightRequest="390"
                HorizontalOptions="End"
                VerticalOptions="Start"
                TranslationX="155"
                TranslationY="-200">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#405B4CF0" Offset="0" />
                        <GradientStop Color="#005B4CF0" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse
                WidthRequest="300"
                HeightRequest="300"
                HorizontalOptions="Start"
                VerticalOptions="End"
                TranslationX="-190"
                TranslationY="140">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#302D75DB" Offset="0" />
                        <GradientStop Color="#002D75DB" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Contenido Central Estilizado -->
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="18" VerticalOptions="Center" HorizontalOptions="Center">

                <Border
                    Background="#F0162035"
                    Stroke="#557C70FF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="24"
                    WidthRequest="360"
                    MaximumWidthRequest="440"
                    HorizontalOptions="Center">

                    <VerticalStackLayout Spacing="16">

                        <!-- Icono de Cabecera -->
                        <Border
                            WidthRequest="48"
                            HeightRequest="48"
                            HorizontalOptions="Start"
                            Background="#302F2A75"
                            Stroke="#505B5CF6"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 15">
                            <Label
                                Text="＋"
                                FontSize="27"
                                TextColor="#C7D2FE"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                        </Border>

                        <!-- Títulos -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Nueva comisión" FontSize="23" FontAttributes="Bold" TextColor="White" />
                            <Label Text="Completá los datos para registrar una cursada." FontSize="13" TextColor="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>

                        <!-- Campo Código -->
                        <Label Text="CÓDIGO DE COMISIÓN" Style="{StaticResource FormLabel}" />
                        <Entry x:Name="CodigoEntry" Style="{StaticResource GlassEntry}" Placeholder="Ej: 1K1" ReturnType="Next" />

                        <!-- Campo Semanas -->
                        <Label Text="DURACIÓN EN SEMANAS" Style="{StaticResource FormLabel}" />
                        <Entry x:Name="SemanasEntry" Style="{StaticResource GlassEntry}" Placeholder="Semanas" Keyboard="Numeric" Text="16" ReturnType="Done" />

                        <!-- Mensaje de Error -->
                        <Label x:Name="ErrorLabel" TextColor="#FDA4AF" FontSize="12" IsVisible="False" />

                        <!-- Botones de Acción -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,5,0,0">
                            <Button
                                Text="Cancelar"
                                BackgroundColor="#20FFFFFF"
                                TextColor="#E2E8F0"
                                BorderColor="#35FFFFFF"
                                BorderWidth="1"
                                CornerRadius="12"
                                MinimumHeightRequest="46"
                                Clicked="OnCancelarClicked" />

                            <Button
                                Grid.Column="1"
                                Text="Guardar"
                                Style="{StaticResource GlassButton}"
                                Clicked="OnGuardarClicked" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>