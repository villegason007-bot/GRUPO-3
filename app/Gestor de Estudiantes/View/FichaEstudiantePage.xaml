<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Gestor_de_Estudiantes.Views.FichaEstudiantePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Gestor_de_Estudiantes.Controls"
    Title="Ficha del estudiante"
    BackgroundColor="#090D18">

    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="16">

        <!-- Encabezado: nombre y legajo/comisión -->
        <VerticalStackLayout Spacing="5">
            <Label
                Text="{Binding NombreCompleto}"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White" />

            <Label
                Text="{Binding Subtitulo}"
                FontSize="13"
                TextColor="#94A3B8" />
        </VerticalStackLayout>

        <!-- Mensaje de estado o de error -->
        <Label
            Grid.Row="1"
            Text="{Binding Mensaje}"
            TextColor="#94A3B8"
            FontSize="13"
            IsVisible="{Binding MostrarMensaje}" />

        <!-- Datos de contacto (H9) -->
        <Border
            Grid.Row="2"
            Style="{StaticResource GlassCard}"
            Padding="18">

            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" RowSpacing="14">

                <VerticalStackLayout Spacing="3">
                    <Label
                        Text="TELÉFONO"
                        FontSize="11"
                        FontAttributes="Bold"
                        CharacterSpacing="1.1"
                        TextColor="#64748B" />

                    <Label
                        Text="{Binding TelefonoTexto}"
                        FontSize="15"
                        TextColor="#E2E8F0" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="3">
                    <Label
                        Text="INCORPORACIÓN"
                        FontSize="11"
                        FontAttributes="Bold"
                        CharacterSpacing="1.1"
                        TextColor="#64748B" />

                    <Label
                        Text="{Binding FechaIncorporacionTexto}"
                        FontSize="15"
                        TextColor="#E2E8F0" />
                </VerticalStackLayout>

            </Grid>
        </Border>

        <!-- Acción: registrar contacto (H10) -->
        <Button
            Grid.Row="3"
            Text="Registrar contacto"
            Style="{StaticResource GlassButton}"
            Clicked="OnRegistrarContactoClicked" />

        <!-- Accesos a los historiales (H12 / H13) -->
        <Grid
            Grid.Row="4"
            ColumnDefinitions="*,*"
            ColumnSpacing="10">

            <Button
                Text="Asistencia"
                Style="{StaticResource SecondaryGlassButton}"
                Clicked="OnHistorialAsistenciaClicked" />

            <Button
                Grid.Column="1"
                Text="Entregas y riesgo"
                Style="{StaticResource SecondaryGlassButton}"
                Clicked="OnHistorialEntregasClicked" />
        </Grid>

        <!-- Historial de contactos (H10) -->
        <Grid
            Grid.Row="5"
            RowDefinitions="Auto,*"
            RowSpacing="10">

            <Label
                Text="Historial de contactos"
                Style="{StaticResource SectionTitle}" />

            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Contactos}">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <controls:EstadoVacio
                        Text="Todavía no registraste contactos."
                        Margin="16"
                        HorizontalOptions="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="#14FF"
                            Padding="15"
                            Stroke="#263244"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14">

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                <!-- Ícono del contacto -->
                                <Border
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    Background="#302F2A75"
                                    Stroke="#505B5CF6"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Center">
                                    <Label
                                        Text="☏"
                                        FontSize="17"
                                        TextColor="#C7D2FE"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />
                                </Border>

                                <!-- Medio y resultado -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3"
                                    VerticalOptions="Center">
                                    <Label
                                        Text="{Binding Resultado}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#F8FAFC" />
                                    <Label
                                        Text="{Binding Medio}"
                                        FontSize="12"
                                        TextColor="#94A3B8" />
                                </VerticalStackLayout>

                                <!-- Fecha -->
                                <Label
                                    Grid.Column="2"
                                    Text="{Binding FechaTexto}"
                                    FontSize="12"
                                    TextColor="#64748B"
                                    VerticalOptions="Center" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

        <!-- Modal: registrar contacto (H10) -->
        <controls:GlassModal
            x:Name="ModalContacto"
            Grid.Row="0"
            Grid.RowSpan="6"
            IsVisible="False"
            ZIndex="10"
            Icono="☏"
            IconoFondo="#302D75DB"
            IconoBorde="#5060A5FA"
            IconoColor="#BFDBFE"
            IconoTamano="25"
            Titulo="Registrar contacto"
            Subtitulo="Cargá el medio utilizado y el resultado obtenido."
            TextoConfirmar="Guardar contacto"
            CancelarClicked="CancelarContacto_Clicked"
            ConfirmarClicked="GuardarContacto_Clicked">

            <controls:GlassModal.Formulario>
                <VerticalStackLayout Spacing="15">
                    <Label
                        Text="MEDIO"
                        Style="{StaticResource FormLabel}" />

                    <Border Style="{StaticResource InnerGlassCard}">
                        <Picker
                            x:Name="MedioPicker"
                            Title="Seleccionar medio"
                            TitleColor="#A5B4FC"
                            TextColor="White"
                            BackgroundColor="Transparent" />
                    </Border>

                    <Label
                        Text="RESULTADO"
                        Style="{StaticResource FormLabel}" />

                    <Border Style="{StaticResource InnerGlassCard}">
                        <Picker
                            x:Name="ResultadoPicker"
                            Title="Seleccionar resultado"
                            TitleColor="#A5B4FC"
                            TextColor="White"
                            BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>
            </controls:GlassModal.Formulario>
        </controls:GlassModal>

    </Grid>

</ContentPage>
