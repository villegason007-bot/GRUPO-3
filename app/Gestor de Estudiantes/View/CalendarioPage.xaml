<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Gestor_de_Estudiantes.Views.CalendarioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#090D18">


    <Grid>

        <!-- Fondo ambiental -->
        <Grid InputTransparent="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#090D18" Offset="0" />
                    <GradientStop Color="#11182A" Offset="0.55" />
                    <GradientStop Color="#201C43" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Ellipse
                WidthRequest="390"
                HeightRequest="390"
                HorizontalOptions="End"
                VerticalOptions="Start"
                TranslationX="155"
                TranslationY="-200">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#405B4CF0" Offset="0" />
                        <GradientStop Color="#005B4CF0" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse
                WidthRequest="300"
                HeightRequest="300"
                HorizontalOptions="Start"
                VerticalOptions="End"
                TranslationX="-190"
                TranslationY="140">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#302D75DB" Offset="0" />
                        <GradientStop Color="#002D75DB" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Contenido Principal -->
        <ScrollView>
            <VerticalStackLayout
                Padding="26,26,26,34"
                Spacing="22">

                <!-- Encabezado -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">

                    <VerticalStackLayout Spacing="7">
                        <Label
                            Text="PLANIFICACIÓN ACADÉMICA"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.7"
                            TextColor="#A5B4FC" />

                        <Label
                            Text="Calendario de cursada"
                            FontSize="32"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Organizá las clases y las fechas de entrega de cada comisión."
                            FontSize="14"
                            TextColor="{StaticResource TextoSecundario}"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Comisión activa -->
                <Border Style="{StaticResource GlassCard}">
                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="01 / COMISIÓN"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1.5"
                                TextColor="#A5B4FC" />
                            <Label
                                Text="Comisión activa"
                                Style="{StaticResource SectionTitle}" />
                            <Label
                                Text="Seleccioná una comisión para ver su agenda."
                                Style="{StaticResource SecondaryText}" />
                        </VerticalStackLayout>

                        <Border Style="{StaticResource InnerGlassCard}">
                            <Picker
                                Title="Seleccioná una comisión"
                                ItemsSource="{Binding Comisiones}"
                                SelectedItem="{Binding ComisionSeleccionada}"
                                ItemDisplayBinding="{Binding Codigo}"
                                TextColor="White"
                                TitleColor="#A5B4FC"
                                BackgroundColor="Transparent" />
                        </Border>

                        <Button
                            Text="↻  Actualizar calendario"
                            Command="{Binding RecargarCommand}"
                            Style="{StaticResource SecondaryGlassButton}"
                            HorizontalOptions="Fill" />

                    </VerticalStackLayout>
                </Border>

                <!-- Topbar -->
                <Border
                    Background="#16FFFFFF"
                    Stroke="#30FFFFFF"
                    StrokeThickness="1"
                    Padding="6"
                    StrokeShape="RoundRectangle 16">

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">

                        <Button
                            x:Name="TabCalendarioButton"
                            Grid.Column="0"
                            Text="▦ Calendario"
                            BackgroundColor="{StaticResource Acento}"
                            TextColor="White"
                            CornerRadius="12"
                            FontAttributes="Bold"
                            FontSize="12"
                            Padding="6,13"
                            Clicked="MostrarCalendarioTab_Clicked" />

                        <Button
                            x:Name="TabClaseButton"
                            Grid.Column="1"
                            Text="+ Clase"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextoSecundario}"
                            CornerRadius="12"
                            FontAttributes="Bold"
                            FontSize="12"
                            Padding="6,13"
                            Clicked="MostrarClaseTab_Clicked" />

                        <Button
                            x:Name="TabTrabajoButton"
                            Grid.Column="2"
                            Text="+ Trabajo"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextoSecundario}"
                            CornerRadius="12"
                            FontAttributes="Bold"
                            FontSize="12"
                            Padding="6,13"
                            Clicked="MostrarTrabajoTab_Clicked" />

                    </Grid>
                </Border>

                <!-- Panel Calendario -->
                <Border
                    x:Name="CalendarioPanel"
                    Style="{StaticResource GlassCard}">

                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="02 / AGENDA"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1.5"
                                TextColor="#A5B4FC" />
                            <Label
                                Text="Eventos de la comisión"
                                Style="{StaticResource SectionTitle}" />
                            <Label
                                Text="Consultá las clases y las próximas fechas de entrega."
                                Style="{StaticResource SecondaryText}" />
                        </VerticalStackLayout>

                        <Label
                            Text="{Binding Mensaje}"
                            TextColor="#93C5FD"
                            FontSize="13" />

                        <Border
                            Style="{StaticResource InnerGlassCard}"
                            IsVisible="{Binding SinEventos}">

                            <VerticalStackLayout
                                Spacing="6"
                                HorizontalOptions="Center">

                                <Label
                                    Text="▦"
                                    FontSize="28"
                                    TextColor="#A5B4FC"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="Todavía no hay eventos"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="Registrá una clase o un trabajo para esta comisión."
                                    TextColor="{StaticResource TextoSecundario}"
                                    FontSize="12"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>
                        </Border>

                        <CollectionView
                            ItemsSource="{Binding Eventos}"
                            SelectionMode="None"
                            HeightRequest="480">

                            <CollectionView.EmptyView>
                                <Label Text="" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout
                                    Orientation="Vertical"
                                    ItemSpacing="10" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="#14FFFFFF"
                                        Stroke="#2DFFFFFF"
                                        StrokeThickness="1"
                                        Padding="15"
                                        StrokeShape="RoundRectangle 16">

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            RowDefinitions="Auto,Auto,Auto"
                                            ColumnSpacing="12"
                                            RowSpacing="8">

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Text="{Binding Titulo}"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                TextColor="White" />

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                BackgroundColor="#342F66"
                                                StrokeThickness="0"
                                                Padding="9,5"
                                                StrokeShape="RoundRectangle 8">

                                                <Label
                                                    Text="{Binding Tipo}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#C7D2FE"
                                                    VerticalOptions="Center" />
                                            </Border>

                                            <Label
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Text="{Binding Fecha, StringFormat='{0:dddd dd/MM/yyyy}'}"
                                                FontSize="14"
                                                TextColor="#CBD5E1" />

                                            <Label
                                                Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                                Text="{Binding Detalle}"
                                                FontSize="12"
                                                TextColor="{StaticResource TextoSecundario}" />

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!-- Panel Registrar Clase -->
                <Border
                    x:Name="ClasePanel"
                    Style="{StaticResource GlassCard}"
                    IsVisible="False">

                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="03 / CLASE"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1.5"
                                TextColor="#A5B4FC" />
                            <Label
                                Text="Registrar clase"
                                Style="{StaticResource SectionTitle}" />
                            <Label
                                Text="Seleccioná la fecha de cursada para la comisión activa."
                                Style="{StaticResource SecondaryText}" />
                        </VerticalStackLayout>

                        <Label
                            Text="FECHA DE LA CLASE"
                            Style="{StaticResource FormLabel}" />

                        <Border Style="{StaticResource InnerGlassCard}">
                            <DatePicker
                                Date="{Binding FechaClase}"
                                TextColor="White"
                                BackgroundColor="Transparent" />
                        </Border>

                        <Button
                            Text="Registrar clase"
                            Command="{Binding RegistrarClaseCommand}"
                            Style="{StaticResource GlassButton}" />

                        <Label
                            Text="{Binding Mensaje}"
                            TextColor="#93C5FD"
                            FontSize="13" />

                    </VerticalStackLayout>
                </Border>

                <!-- Panel Registrar Trabajo -->
                <Border
                    x:Name="TrabajoPanel"
                    Style="{StaticResource GlassCard}"
                    IsVisible="False">

                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="04 / TRABAJO"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1.5"
                                TextColor="#A5B4FC" />
                            <Label
                                Text="Registrar trabajo"
                                Style="{StaticResource SectionTitle}" />
                            <Label
                                Text="Definí el título y la fecha de entrega del trabajo."
                                Style="{StaticResource SecondaryText}" />
                        </VerticalStackLayout>

                        <Label
                            Text="TÍTULO DEL TRABAJO"
                            Style="{StaticResource FormLabel}" />

                        <Entry
                            Placeholder="Ej.: Trabajo práctico 1"
                            Text="{Binding TituloTrabajo}"
                            Style="{StaticResource GlassEntry}" />

                        <Label
                            Text="FECHA DE ENTREGA"
                            Style="{StaticResource FormLabel}" />

                        <Border Style="{StaticResource InnerGlassCard}">
                            <DatePicker
                                Date="{Binding FechaEntrega}"
                                TextColor="White"
                                BackgroundColor="Transparent" />
                        </Border>

                        <Button
                            Text="Registrar trabajo"
                            Command="{Binding RegistrarTrabajoCommand}"
                            Style="{StaticResource GlassButton}" />

                        <Label
                            Text="{Binding Mensaje}"
                            TextColor="#93C5FD"
                            FontSize="13" />

                    </VerticalStackLayout>
                </Border>

                <!-- Pie -->
                <Label
                    Text="GESTOR DE ESTUDIANTES  ·  ESPACIO ACADÉMICO"
                    FontSize="10"
                    CharacterSpacing="1.1"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center"
                    Margin="0,4,0,0" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>