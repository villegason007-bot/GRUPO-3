<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Gestor_de_Estudiantes.MainPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#090D18">

    <ContentPage.Resources>
        <ResourceDictionary>

            <Style x:Key="GlassSurface" TargetType="Border">
                <Setter Property="Background" Value="#14FFFFFF" />
                <Setter Property="Stroke" Value="#25FFFFFF" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="22" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="22" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#AEB9CE" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="Padding" Value="14,13" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="PrimaryAction" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#7667F5" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18,13" />
                <Setter Property="HorizontalOptions" Value="Fill" />
            </Style>

            <Style x:Key="SecondaryAction" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#16FFFFFF" />
                <Setter Property="TextColor" Value="#E2E8F0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BorderColor" Value="#30FFFFFF" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="HorizontalOptions" Value="Fill" />
            </Style>

            <Style x:Key="Eyebrow" TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.5" />
                <Setter Property="TextColor" Value="#A5B4FC" />
            </Style>

            <Style x:Key="ModuleTitle" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#F8FAFC" />
            </Style>

            <Style x:Key="ModuleDescription" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="#AEBBD0" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <!-- FONDO AMBIENTAL -->
        <Grid InputTransparent="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#090D18" Offset="0" />
                    <GradientStop Color="#11182A" Offset="0.55" />
                    <GradientStop Color="#201C43" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Ellipse
                WidthRequest="500"
                HeightRequest="500"
                HorizontalOptions="End"
                VerticalOptions="Start"
                TranslationX="160"
                TranslationY="-280">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#555B4CF0" Offset="0" />
                        <GradientStop Color="#005B4CF0" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- ÁREA PRINCIPAL -->
        <ScrollView>
            <VerticalStackLayout
                Padding="30,26,30,32"
                Spacing="23">

                <!-- Cabecera superior -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="VISTA GENERAL"
                            Style="{StaticResource Eyebrow}" />
                        <Label
                            Text="Tu espacio académico"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="White" />
                        <Label
                            Text="Gestioná la cursada y acompañá el progreso de tus estudiantes."
                            FontSize="14"
                            TextColor="#AEBBD0" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        Padding="13,9"
                        VerticalOptions="Start"
                        Background="#15FFFFFF"
                        Stroke="#30FFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                        <HorizontalStackLayout Spacing="8">
                            <Ellipse
                                WidthRequest="7"
                                HeightRequest="7"
                                Fill="#86EFAC"
                                VerticalOptions="Center" />
                            <Label
                                Text="Panel de gestión"
                                FontSize="11"
                                TextColor="#DCE5F5"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- BLOQUE DESTACADO: RIESGO -->
                <Border
                    Padding="0"
                    Background="#182E2A69"
                    Stroke="#506F64E8"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 26">

                    <Grid ColumnDefinitions="*,230">

                        <VerticalStackLayout
                            Padding="26"
                            Spacing="14">

                            <Border
                                Padding="10,6"
                                HorizontalOptions="Start"
                                Background="#302F2A75"
                                Stroke="#505B5CF6"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 9">
                                <Label
                                    Text="SEGUIMIENTO INTELIGENTE"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1"
                                    TextColor="#C7D2FE" />
                            </Border>

                            <Label
                                Text="Detectá señales.&#10;Acompañá a tiempo."
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="White"
                                LineHeight="1.1" />

                            <Label
                                Text="Consultá el indicador de riesgo considerando las inasistencias y los trabajos pendientes de tus estudiantes."
                                FontSize="14"
                                TextColor="#C8D0E4"
                                LineBreakMode="WordWrap" />

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10"
                                Margin="0,5,0,0">

                                <Button
                                    Text="Panel de Riesgo  →"
                                    Style="{StaticResource PrimaryAction}"
                                    Clicked="OnRiesgoClicked"
                                    />

                                <Button
                                    Grid.Column="1"
                                    Text="Criterios de riesgo"
                                    Style="{StaticResource SecondaryAction}"
                                    BackgroundColor="Grey"
                                    />

                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- MÓDULOS -->
                <VerticalStackLayout Spacing="5">
                    <Label
                        Text="OPERACIONES"
                        Style="{StaticResource Eyebrow}" />
                    <Label
                        Text="Accesos directos"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="White" />
                </VerticalStackLayout>

                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="16"
                    RowSpacing="16">

                    <!-- Comisiones -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource GlassSurface}">
                        <Grid
                            ColumnDefinitions="48,*"
                            ColumnSpacing="14">
                            <Border
                                WidthRequest="46"
                                HeightRequest="46"
                                Background="#302D75DB"
                                Stroke="#5060A5FA"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                VerticalOptions="Start">
                                <Label
                                    Text="▤"
                                    FontSize="25"
                                    TextColor="#BFDBFE"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="8">
                                <Label
                                    Text="Comisiones y estudiantes"
                                    Style="{StaticResource ModuleTitle}" />
                                <Label
                                    Text="Administrá comisiones y consultá la nómina."
                                    Style="{StaticResource ModuleDescription}" />
                                <Button
                                    Text="Abrir comisiones  →"
                                    Style="{StaticResource SecondaryAction}"
                                    Margin="0,5,0,0"
                                    Clicked="OnVerComisionesClicked" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Asistencia -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource GlassSurface}">
                        <Grid
                            ColumnDefinitions="48,*"
                            ColumnSpacing="14">
                            <Border
                                WidthRequest="46"
                                HeightRequest="46"
                                Background="#3022A66B"
                                Stroke="#504ADE80"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                VerticalOptions="Start">
                                <Label
                                    Text="✓"
                                    FontSize="25"
                                    FontAttributes="Bold"
                                    TextColor="#BBF7D0"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="8">
                                <Label
                                    Text="Asistencia y entregas"
                                    Style="{StaticResource ModuleTitle}" />
                                <Label
                                    Text="Registrá presentes, ausentes y entregas de trabajos."
                                    Style="{StaticResource ModuleDescription}" />
                                <Button
                                    Text="Registrar actividad  →"
                                    Style="{StaticResource SecondaryAction}"
                                    Margin="0,5,0,0"
                                    Clicked="OnAsistenciaEntregasClicked" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Calendario -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource GlassSurface}">
                        <Grid
                            ColumnDefinitions="48,*"
                            ColumnSpacing="14">
                            <Border
                                WidthRequest="46"
                                HeightRequest="46"
                                Background="#303F3ABF"
                                Stroke="#605B5CF6"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                VerticalOptions="Start">
                                <Label
                                    Text="▦"
                                    FontSize="25"
                                    TextColor="#DDD6FE"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="8">
                                <Label
                                    Text="Calendario académico"
                                    Style="{StaticResource ModuleTitle}" />
                                <Label
                                    Text="Organizá fechas de clases y vencimientos por comisión."
                                    Style="{StaticResource ModuleDescription}" />
                                <Button
                                    Text="Administrar calendario  →"
                                    Style="{StaticResource SecondaryAction}"
                                    Margin="0,5,0,0"
                                    Clicked="OnCalendarioClicked" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Configuración -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource GlassSurface}">
                        <Grid
                            ColumnDefinitions="48,*"
                            ColumnSpacing="14">
                            <Border
                                WidthRequest="46"
                                HeightRequest="46"
                                Background="#304B5563"
                                Stroke="#50647589"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                VerticalOptions="Start">
                                <Label
                                    Text="⚙"
                                    FontSize="25"
                                    TextColor="#E2E8F0"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="8">
                                <Label
                                    Text="Criterios de evaluación"
                                    Style="{StaticResource ModuleTitle}" />
                                <Label
                                    Text="Ajustá el umbral y los límites que determinan las alertas."
                                    Style="{StaticResource ModuleDescription}" />
                                <Button
                                    Text="Configurar riesgo  →"
                                    Style="{StaticResource SecondaryAction}"
                                    Margin="0,5,0,0"
                                     />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </Grid>

                <Label
                    Text="GESTOR DE ESTUDIANTES  ·  ESPACIO ACADÉMICO"
                    FontSize="10"
                    CharacterSpacing="1.1"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center"
                    Margin="0,5,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>