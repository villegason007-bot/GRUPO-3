<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Gestor_de_Estudiantes.Views.ComisionesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#090D18">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Superficies Liquid Glass -->
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="#16FFFFFF" />
                <Setter Property="Stroke" Value="#30FFFFFF" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="22" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="22" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="InnerGlassCard" TargetType="Border">
                <Setter Property="Background" Value="#12FFFFFF" />
                <Setter Property="Stroke" Value="#25FFFFFF" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="15" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="16" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GlassButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#7667F5" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="17,12" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="MinimumHeightRequest" Value="46" />
            </Style>

            <Style x:Key="SecondaryGlassButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#18FFFFFF" />
                <Setter Property="TextColor" Value="#E2E8F0" />
                <Setter Property="BorderColor" Value="#35FFFFFF" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Padding" Value="13,9" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="MinimumHeightRequest" Value="40" />
            </Style>

            <Style x:Key="GlassEntry" TargetType="Entry">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="PlaceholderColor" Value="#8290AA" />
                <Setter Property="BackgroundColor" Value="#182235" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#F8FAFC" />
            </Style>

            <Style x:Key="SecondaryText" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="#AEBBD0" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <Style x:Key="FormLabel" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#C8D2E5" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <!-- Fondo ambiental -->
        <Grid InputTransparent="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#090D18" Offset="0" />
                    <GradientStop Color="#11182A" Offset="0.55" />
                    <GradientStop Color="#201C43" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Ellipse
                WidthRequest="390"
                HeightRequest="390"
                HorizontalOptions="End"
                VerticalOptions="Start"
                TranslationX="155"
                TranslationY="-200">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#405B4CF0" Offset="0" />
                        <GradientStop Color="#005B4CF0" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse
                WidthRequest="300"
                HeightRequest="300"
                HorizontalOptions="Start"
                VerticalOptions="End"
                TranslationX="-190"
                TranslationY="140">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#302D75DB" Offset="0" />
                        <GradientStop Color="#002D75DB" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <ScrollView>
            <VerticalStackLayout
                Padding="26,26,26,34"
                Spacing="22">

                <!-- Encabezado -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">

                    <VerticalStackLayout Spacing="7">
                        <Label
                            Text="ESPACIO ACADÉMICO"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.7"
                            TextColor="#A5B4FC" />

                        <Label
                            Text="Comisiones"
                            FontSize="32"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Organizá las cursadas y administrá la nómina de estudiantes."
                            FontSize="14"
                            TextColor="#AEBBD0"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        Padding="11,8"
                        VerticalOptions="Start"
                        Background="#16FFFFFF"
                        Stroke="#30FFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                        <HorizontalStackLayout
                            Spacing="7"
                            VerticalOptions="Center">
                            <Ellipse
                                WidthRequest="7"
                                HeightRequest="7"
                                Fill="#86EFAC"
                                VerticalOptions="Center" />
                            <Label
                                Text="Gestión"
                                FontSize="11"
                                TextColor="#DCE5F5"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Panel de comisiones -->
                <!-- TOPBAR: CAMBIO DE SECCIÓN -->
                <Border
    Background="#16FFFFFF"
    Stroke="#30FFFFFF"
    StrokeThickness="1"
    Padding="6"
    StrokeShape="RoundRectangle 16">

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">

                        <Button
            x:Name="TabComisionesButton"
            Text="▤   Comisiones"
            BackgroundColor="#7667F5"
            TextColor="White"
            FontAttributes="Bold"
            FontSize="13"
            CornerRadius="12"
            Padding="12,13"
            Clicked="MostrarComisionesTab_Clicked" />

                        <Button
            x:Name="TabEstudiantesButton"
            Grid.Column="1"
            Text="◎   Estudiantes"
            BackgroundColor="Transparent"
            TextColor="#AEBBD0"
            FontAttributes="Bold"
            FontSize="13"
            CornerRadius="12"
            Padding="12,13"
            Clicked="MostrarEstudiantesTab_Clicked" />

                    </Grid>
                </Border>

                <!-- PESTAÑA: COMISIONES -->
                <Border
    x:Name="ComisionesPanel"
    Background="#16FFFFFF"
    Stroke="#30FFFFFF"
    StrokeThickness="1"
    Padding="22"
    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="17">

                        <VerticalStackLayout Spacing="6">
                            <Label
                Text="01 / CURSADAS"
                FontSize="10"
                FontAttributes="Bold"
                CharacterSpacing="1.5"
                TextColor="#A5B4FC" />

                            <Label
                Text="Comisiones disponibles"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="White" />

                            <Label
                Text="Consultá las cursadas registradas o creá una nueva comisión."
                FontSize="13"
                TextColor="#AEBBD0" />
                        </VerticalStackLayout>

                        <Button
            Text="+ Agregar comisión"
            Style="{StaticResource GlassButton}"
            Clicked="AbrirModalComision_Clicked" />

                        <BoxView HeightRequest="1" Color="#24FFFFFF" />

                        <Label
            x:Name="SinComisionesLabel"
            Text="Todavía no hay comisiones. Usá el botón para crear la primera."
            TextColor="#AEBBD0"
            FontSize="13"
            HorizontalTextAlignment="Center"
            Margin="0,12"
            IsVisible="False" />

                        <CollectionView
            x:Name="ComisionesList"
            SelectionMode="None"
            HeightRequest="300">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="10" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                        Background="#14FFFFFF"
                        Stroke="#2DFFFFFF"
                        StrokeThickness="1"
                        Padding="15"
                        StrokeShape="RoundRectangle 16">

                                        <Grid
                            ColumnDefinitions="42,*,Auto"
                            ColumnSpacing="12">

                                            <Border
                                WidthRequest="42"
                                HeightRequest="42"
                                VerticalOptions="Center"
                                Background="#302F2A75"
                                Stroke="#505B5CF6"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 13">
                                                <Label
                                    Text="▤"
                                    FontSize="22"
                                    TextColor="#C7D2FE"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                                            </Border>

                                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="5">

                                                <Label
                                    Text="{Binding Codigo}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                                                <Label
                                    Text="{Binding Semanas, StringFormat='Duración: {0} semanas'}"
                                    FontSize="12"
                                    TextColor="#AEBBD0" />
                                            </VerticalStackLayout>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!-- PESTAÑA: ESTUDIANTES -->
                <Border
    x:Name="EstudiantesPanel"
    IsVisible="False"
    Background="#16FFFFFF"
    Stroke="#30FFFFFF"
    StrokeThickness="1"
    Padding="22"
    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="17">

                        <VerticalStackLayout Spacing="6">
                            <Label
                Text="02 / NÓMINA"
                FontSize="10"
                FontAttributes="Bold"
                CharacterSpacing="1.5"
                TextColor="#A5B4FC" />

                            <Label
                Text="Estudiantes por comisión"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="White" />

                            <Label
                Text="Seleccioná una comisión para consultar sus estudiantes o agregar integrantes."
                FontSize="13"
                TextColor="#AEBBD0" />
                        </VerticalStackLayout>

                        <Label
            Text="COMISIÓN"
            FontSize="10"
            FontAttributes="Bold"
            CharacterSpacing="1"
            TextColor="#AEBBD0" />

                        <Border
            Background="#12FFFFFF"
            Stroke="#30FFFFFF"
            StrokeThickness="1"
            Padding="10,2"
            StrokeShape="RoundRectangle 14">

                            <Picker
                x:Name="ComisionFiltroPicker"
                Title="Seleccionar comisión"
                TitleColor="#A5B4FC"
                TextColor="White"
                BackgroundColor="Transparent"
                ItemDisplayBinding="{Binding Codigo}"
                SelectedIndexChanged="ComisionFiltro_Changed" />
                        </Border>

                        <Button
            Text="+ Agregar estudiante a esta comisión"
            Style="{StaticResource GlassButton}"
            Clicked="AbrirModalEstudiante_Clicked" />

                        <BoxView HeightRequest="1" Color="#24FFFFFF" />

                        <Label
            x:Name="TituloNominaLabel"
            Text="Estudiantes"
            FontSize="17"
            FontAttributes="Bold"
            TextColor="White" />

                        <Label
            x:Name="SinEstudiantesLabel"
            Text="Seleccioná una comisión para consultar la nómina."
            TextColor="#AEBBD0"
            FontSize="13"
            HorizontalTextAlignment="Center"
            Margin="0,12"
            IsVisible="True" />

                        <CollectionView
            x:Name="EstudiantesList"
            SelectionMode="None"
            HeightRequest="340">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="9" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                        Background="#14FFFFFF"
                        Stroke="#2DFFFFFF"
                        StrokeThickness="1"
                        Padding="14"
                        StrokeShape="RoundRectangle 15">

                                        <Grid
                            ColumnDefinitions="42,*"
                            ColumnSpacing="12">

                                            <Border
                                WidthRequest="42"
                                HeightRequest="42"
                                VerticalOptions="Start"
                                Background="#302D75DB"
                                Stroke="#5060A5FA"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 13">
                                                <Label
                                    Text="◎"
                                    FontSize="23"
                                    TextColor="#BFDBFE"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                                            </Border>

                                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="5">

                                                <Label
                                    Text="{Binding Nombre}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                                                <Label
                                    Text="{Binding Apellido, StringFormat='Apellido: {0}'}"
                                    FontSize="12"
                                    TextColor="#CBD5E1" />

                                                <Label
                                    Text="{Binding Legajo, StringFormat='Legajo: {0}'}"
                                    FontSize="12"
                                    TextColor="#A5B4FC" />
                                            </VerticalStackLayout>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>
                <!-- Pie -->
                <Label
                    Text="GESTOR DE ESTUDIANTES  ·  ESPACIO ACADÉMICO"
                    FontSize="10"
                    CharacterSpacing="1.1"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center"
                    Margin="0,4,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Modal: nueva comisión -->
        <Grid
            x:Name="ModalComision"
            IsVisible="False"
            ZIndex="10"
            BackgroundColor="#D9090D18"
            Padding="20">

            <Border
                Background="#F0162035"
                Stroke="#557C70FF"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="23"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                MaximumWidthRequest="440"
                WidthRequest="340">

                <VerticalStackLayout Spacing="15">

                    <Border
                        WidthRequest="48"
                        HeightRequest="48"
                        HorizontalOptions="Start"
                        Background="#302F2A75"
                        Stroke="#505B5CF6"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 15">
                        <Label
                            Text="＋"
                            FontSize="27"
                            TextColor="#C7D2FE"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="Nueva comisión"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Completá los datos para registrar una cursada."
                            FontSize="13"
                            TextColor="#AEBBD0" />
                    </VerticalStackLayout>

                    <Label
                        Text="CÓDIGO DE COMISIÓN"
                        Style="{StaticResource FormLabel}" />

                    <Entry
                        x:Name="CodigoComisionEntry"
                        Style="{StaticResource GlassEntry}"
                        Placeholder="Ej. COM-101"
                        ReturnType="Next" />

                    <Label
                        Text="DURACIÓN EN SEMANAS"
                        Style="{StaticResource FormLabel}" />

                    <Entry
                        x:Name="SemanasEntry"
                        Style="{StaticResource GlassEntry}"
                        Text="16"
                        Keyboard="Numeric"
                        ReturnType="Done" />

                    <Label
                        x:Name="ErrorComisionLabel"
                        TextColor="#FDA4AF"
                        FontSize="12"
                        IsVisible="False" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        Margin="0,5,0,0">

                        <Button
                            Text="Cancelar"
                            BackgroundColor="#20FFFFFF"
                            TextColor="#E2E8F0"
                            BorderColor="#35FFFFFF"
                            BorderWidth="1"
                            CornerRadius="12"
                            MinimumHeightRequest="46"
                            Clicked="CancelarModal_Clicked" />

                        <Button
                            Grid.Column="1"
                            Text="Guardar comisión"
                            Style="{StaticResource GlassButton}"
                            Clicked="GuardarComision_Clicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Modal: nuevo estudiante -->
        <Grid
            x:Name="ModalEstudiante"
            IsVisible="False"
            ZIndex="11"
            BackgroundColor="#D9090D18"
            Padding="20">

            <Border
                Background="#F0162035"
                Stroke="#557C70FF"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="23"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                MaximumWidthRequest="440"
                WidthRequest="340">

                <ScrollView>
                    <VerticalStackLayout Spacing="14">

                        <Border
                            WidthRequest="48"
                            HeightRequest="48"
                            HorizontalOptions="Start"
                            Background="#302D75DB"
                            Stroke="#5060A5FA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 15">
                            <Label
                                Text="◎"
                                FontSize="25"
                                TextColor="#BFDBFE"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Spacing="5">
                            <Label
                                Text="Nuevo estudiante"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                Text="Ingresá los datos y asignalo a una comisión."
                                FontSize="13"
                                TextColor="#AEBBD0" />
                        </VerticalStackLayout>

                        <Label
                            Text="LEGAJO"
                            Style="{StaticResource FormLabel}" />

                        <Entry
                            x:Name="LegajoEntry"
                            Style="{StaticResource GlassEntry}"
                            Placeholder="Número de legajo"
                            ReturnType="Next" />

                        <Label
                            Text="NOMBRE"
                            Style="{StaticResource FormLabel}" />

                        <Entry
                            x:Name="NombreEstudianteEntry"
                            Style="{StaticResource GlassEntry}"
                            Placeholder="Nombre del estudiante"
                            ReturnType="Done" />

                        <Label
                            Text="COMISIÓN"
                            Style="{StaticResource FormLabel}" />

                        <Border Style="{StaticResource InnerGlassCard}">
                            <Picker
                                x:Name="ComisionEstudiantePicker"
                                Title="Seleccionar comisión"
                                TitleColor="#A5B4FC"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                ItemDisplayBinding="{Binding Codigo}" />
                        </Border>

                        <Label
                            x:Name="ErrorEstudianteLabel"
                            TextColor="#FDA4AF"
                            FontSize="12"
                            IsVisible="False" />

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10"
                            Margin="0,5,0,0">

                            <Button
                                Text="Cancelar"
                                BackgroundColor="#20FFFFFF"
                                TextColor="#E2E8F0"
                                BorderColor="#35FFFFFF"
                                BorderWidth="1"
                                CornerRadius="12"
                                MinimumHeightRequest="46"
                                Clicked="CancelarModal_Clicked" />

                            <Button
                                Grid.Column="1"
                                Text="Guardar estudiante"
                                Style="{StaticResource GlassButton}"
                                Clicked="GuardarEstudiante_Clicked" />
                        </Grid>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

    </Grid>
</ContentPage>