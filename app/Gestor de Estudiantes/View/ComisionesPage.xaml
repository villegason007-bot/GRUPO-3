<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Gestor_de_Estudiantes.Views.ComisionesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Gestor_de_Estudiantes.Controls"
    Title="Comisiones"
    BackgroundColor="#090D18">

    <Grid>
        <controls:FondoAmbiental />

        <Grid Padding="26,26,26,16" RowDefinitions="Auto,*" RowSpacing="18">

            <!-- Encabezado -->
            <VerticalStackLayout Spacing="14">
                <VerticalStackLayout Spacing="7">
                    <Label Text="ESPACIO ACADÉMICO" FontSize="10" FontAttributes="Bold"
                           CharacterSpacing="1.7" TextColor="#A5B4FC" />
                    <Label Text="Comisiones" FontSize="32" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Elegí una comisión para ver sus materias y estudiantes."
                           FontSize="14" TextColor="{StaticResource TextoSecundario}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <Button Text="+ Agregar comisión"
                        Style="{StaticResource GlassButton}"
                        Clicked="AbrirModalComision_Clicked" />
            </VerticalStackLayout>

            <!-- Lista -->
            <Grid Grid.Row="1">
                <controls:EstadoVacio
                    x:Name="SinComisionesLabel"
                    Text="Todavía no hay comisiones. Usá el botón para crear la primera."
                    VerticalOptions="Start"
                    Margin="0,12"
                    IsVisible="False" />

                <CollectionView
                    x:Name="ComisionesList"
                    SelectionMode="Single"
                    SelectionChanged="ComisionesList_SelectionChanged">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#16FFFFFF" Stroke="#30FFFFFF" StrokeThickness="1"
                                    Padding="18,16" StrokeShape="RoundRectangle 18">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border WidthRequest="46" HeightRequest="46"
                                            Background="#302D75DB" Stroke="#5060A5FA"
                                            StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                        <Label Text="▤" FontSize="20" TextColor="#BFDBFE"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding Codigo}" FontSize="18"
                                               FontAttributes="Bold" TextColor="White" />
                                        <Label Text="{Binding Semanas, StringFormat='Duración: {0} semanas'}"
                                               FontSize="12" TextColor="{StaticResource TextoSecundario}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="26"
                                           TextColor="#A5B4FC" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <controls:AvisoToast x:Name="Aviso" ZIndex="20" />

        <!-- Modal: nueva comisión -->
        <controls:GlassModal
            x:Name="ModalComision"
            IsVisible="False"
            ZIndex="10"
            Titulo="Nueva comisión"
            Subtitulo="Completá los datos para registrar una cursada."
            TextoConfirmar="Guardar comisión"
            CancelarClicked="CancelarModal_Clicked"
            ConfirmarClicked="GuardarComision_Clicked">
            <controls:GlassModal.Formulario>
                <VerticalStackLayout Spacing="15">
                    <Label Text="CÓDIGO DE COMISIÓN" Style="{StaticResource FormLabel}" />
                    <Entry x:Name="CodigoComisionEntry" Style="{StaticResource GlassEntry}"
                           Placeholder="Ej. 1K1" ReturnType="Next" />
                    <Label Text="DURACIÓN EN SEMANAS" Style="{StaticResource FormLabel}" />
                    <Entry x:Name="SemanasEntry" Style="{StaticResource GlassEntry}"
                           Text="16" Keyboard="Numeric" ReturnType="Done" />
                </VerticalStackLayout>
            </controls:GlassModal.Formulario>
        </controls:GlassModal>
    </Grid>
</ContentPage>
