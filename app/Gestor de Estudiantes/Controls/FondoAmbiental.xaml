<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Gestor_de_Estudiantes.Controls.FondoAmbiental"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    InputTransparent="True">

	<Grid InputTransparent="True">
		<Grid.Background>
			<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
				<GradientStop Color="#090D18" Offset="0" />
				<GradientStop Color="#11182A" Offset="0.55" />
				<GradientStop Color="#201C43" Offset="1" />
			</LinearGradientBrush>
		</Grid.Background>

		<Ellipse WidthRequest="390" HeightRequest="390"
                 HorizontalOptions="End" VerticalOptions="Start"
                 TranslationX="155" TranslationY="-200">
			<Ellipse.Fill>
				<RadialGradientBrush>
					<GradientStop Color="#405B4CF0" Offset="0" />
					<GradientStop Color="#005B4CF0" Offset="1" />
				</RadialGradientBrush>
			</Ellipse.Fill>
		</Ellipse>

		<Ellipse WidthRequest="300" HeightRequest="300"
                 HorizontalOptions="Start" VerticalOptions="End"
                 TranslationX="-190" TranslationY="140">
			<Ellipse.Fill>
				<RadialGradientBrush>
					<GradientStop Color="#302D75DB" Offset="0" />
					<GradientStop Color="#002D75DB" Offset="1" />
				</RadialGradientBrush>
			</Ellipse.Fill>
		</Ellipse>
	</Grid>
</ContentView>
