<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Gestor_de_Estudiantes.Controls.FondoAmbiental"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    InputTransparent="True">

	<Grid InputTransparent="True" BackgroundColor="#090D18">

		<!-- Imagen de fondo -->
		<Image
            Source="fondo.jpg"
            Aspect="AspectFill"
            Opacity="0.7"
            InputTransparent="True" />

		<!-- Capa oscura intermedia: se distingue el fondo y los textos blancos se leen bien -->
		<BoxView
            Color="#BF090D18"
            InputTransparent="True" />

		<!-- Brillos de color -->
		<Ellipse WidthRequest="390" HeightRequest="390"
                 HorizontalOptions="End" VerticalOptions="Start"
                 TranslationX="155" TranslationY="-200"
                 InputTransparent="True">
			<Ellipse.Fill>
				<RadialGradientBrush>
					<GradientStop Color="#403B82F6" Offset="0" />
					<GradientStop Color="#003B82F6" Offset="1" />
				</RadialGradientBrush>
			</Ellipse.Fill>
		</Ellipse>

		<Ellipse WidthRequest="300" HeightRequest="300"
                 HorizontalOptions="Start" VerticalOptions="End"
                 TranslationX="-190" TranslationY="140"
                 InputTransparent="True">
			<Ellipse.Fill>
				<RadialGradientBrush>
					<GradientStop Color="#3022C55E" Offset="0" />
					<GradientStop Color="#0022C55E" Offset="1" />
				</RadialGradientBrush>
			</Ellipse.Fill>
		</Ellipse>
	</Grid>
</ContentView>