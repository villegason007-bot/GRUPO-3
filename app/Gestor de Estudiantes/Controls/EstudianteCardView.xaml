<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Gestor_de_Estudiantes.Controls.EstudianteCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Tarjeta de estudiante para el ItemTemplate de las listas.
         El BindingContext es el Estudiante (Nombre, Apellido, Legajo). -->
    <Border
        Background="#14FFFFFF"
        Stroke="#2DFFFFFF"
        StrokeThickness="1"
        Padding="14"
        StrokeShape="RoundRectangle 15">

        <Grid
            ColumnDefinitions="42,*"
            ColumnSpacing="12">

            <Border
                WidthRequest="42"
                HeightRequest="42"
                VerticalOptions="Start"
                Background="#302D75DB"
                Stroke="#5060A5FA"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 13">
                <Label
                    Text="◎"
                    FontSize="23"
                    TextColor="#BFDBFE"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />
            </Border>

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="5">

                <Label
                    Text="{Binding Nombre}"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="{Binding Apellido, StringFormat='Apellido: {0}'}"
                    FontSize="12"
                    TextColor="#CBD5E1" />

                <Label
                    Text="{Binding Legajo, StringFormat='Legajo: {0}'}"
                    FontSize="12"
                    TextColor="#A5B4FC" />
            </VerticalStackLayout>

        </Grid>
    </Border>
</ContentView>
