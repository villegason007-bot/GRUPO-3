<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Gestor_de_Estudiantes.Controls.EstadoVacio"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Raiz">

    <!-- Mensaje centrado para listas sin datos (reemplaza los labels
         "Todavía no hay…"/"No hay estudiantes…" repetidos en cada página). -->
    <Label
        Text="{Binding Text, Source={x:Reference Raiz}}"
        FontSize="{Binding TamanoTexto, Source={x:Reference Raiz}}"
        TextColor="{Binding ColorTexto, Source={x:Reference Raiz}}"
        HorizontalTextAlignment="Center" />
</ContentView>
