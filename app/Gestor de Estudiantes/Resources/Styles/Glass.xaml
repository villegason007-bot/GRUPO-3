<?xml version="1.0" encoding="utf-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<Style x:Key="GlassCard" TargetType="Border">
		<Setter Property="Background" Value="#16FFFFFF" />
		<Setter Property="Stroke" Value="#40608AC0" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Padding" Value="22" />
		<Setter Property="StrokeShape" Value="RoundRectangle 22" />
	</Style>

	<Style x:Key="InnerGlassCard" TargetType="Border">
		<Setter Property="Background" Value="#14FFFFFF" />
		<Setter Property="Stroke" Value="#35608AC0" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Padding" Value="15" />
		<Setter Property="StrokeShape" Value="RoundRectangle 16" />
	</Style>

	<Style x:Key="GlassButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource Acento}" />
		<Setter Property="TextColor" Value="White" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="Padding" Value="17,12" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="MinimumHeightRequest" Value="46" />
		<Setter Property="VisualStateManager.VisualStateGroups">
			<VisualStateGroupList>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="Normal">
						<VisualState.Setters>
							<Setter Property="BackgroundColor" Value="{StaticResource Acento}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="PointerOver">
						<VisualState.Setters>
							<Setter Property="BackgroundColor" Value="{StaticResource AcentoHover}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Pressed">
						<VisualState.Setters>
							<Setter Property="BackgroundColor" Value="{StaticResource AcentoPresionado}" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
			</VisualStateGroupList>
		</Setter>
	</Style>

	<Style x:Key="SecondaryGlassButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="#18FFFFFF" />
		<Setter Property="TextColor" Value="#E2E8F0" />
		<Setter Property="BorderColor" Value="#40608AC0" />
		<Setter Property="BorderWidth" Value="1" />
		<Setter Property="CornerRadius" Value="11" />
		<Setter Property="Padding" Value="13,9" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="MinimumHeightRequest" Value="40" />
		<Setter Property="VisualStateManager.VisualStateGroups">
			<VisualStateGroupList>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="Normal">
						<VisualState.Setters>
							<Setter Property="BackgroundColor" Value="#18FFFFFF" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="PointerOver">
						<VisualState.Setters>
							<Setter Property="BackgroundColor" Value="#2A3B82F6" />
							<Setter Property="BorderColor" Value="#3B82F6" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Pressed">
						<VisualState.Setters>
							<Setter Property="BackgroundColor" Value="#553B82F6" />
							<Setter Property="BorderColor" Value="#60A5FA" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
			</VisualStateGroupList>
		</Setter>
	</Style>

	<Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
		<Setter Property="BackgroundColor" Value="{StaticResource Exito}" />
	</Style>

	<Style x:Key="GlassEntry" TargetType="Entry">
		<Setter Property="TextColor" Value="White" />
		<Setter Property="PlaceholderColor" Value="#8290AA" />
		<Setter Property="BackgroundColor" Value="#182235" />
		<Setter Property="HeightRequest" Value="50" />
		<Setter Property="Margin" Value="0,3,0,0" />
	</Style>

	<Style x:Key="SectionTitle" TargetType="Label">
		<Setter Property="FontSize" Value="20" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="#F8FAFC" />
	</Style>

	<Style x:Key="SecondaryText" TargetType="Label">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="{StaticResource TextoSecundario}" />
		<Setter Property="LineBreakMode" Value="WordWrap" />
	</Style>

	<Style x:Key="FormLabel" TargetType="Label">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="#BFD3F2" />
	</Style>

</ResourceDictionary>